# -------------------------------------------------------
# SentinelAI Backend — Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real secrets.
# -------------------------------------------------------

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel_db
DB_USER=sentinel_user
DB_PASSWORD=sentinel_secret_password

# JWT  (min 32 chars, use a strong random string in prod)
JWT_SECRET=sentinelai-local-dev-secret-key-change-in-production-256bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Default admin seeded on first startup
DEFAULT_ADMIN_EMAIL=admin@sentinelai.local
DEFAULT_ADMIN_PASSWORD=Admin@123

# URLs
FRONTEND_URL=http://localhost:5173
AI_ENGINE_URL=http://localhost:8000
