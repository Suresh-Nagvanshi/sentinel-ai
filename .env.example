# SentinelAI Global Environment Variables Example

# PostgreSQL Config
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_secret_password
POSTGRES_PORT=5432

# Spring Boot Backend Config
BACKEND_PORT=8080
JWT_SECRET=replace-with-a-random-256-bit-secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
DEFAULT_ADMIN_EMAIL=admin@sentinelai.local
DEFAULT_ADMIN_PASSWORD=replace-in-local-environment
FRONTEND_URL=http://localhost:3000

# FastAPI AI Engine Config
AI_ENGINE_PORT=8000
AI_ENGINE_URL=http://localhost:8000

# React Frontend Config
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/ws
